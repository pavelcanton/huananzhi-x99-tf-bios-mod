# Preserve exact CRLF line endings in git objects (for GitHub "Download ZIP" too)
*.bat -text
*.ps1 text eol=crlf

# Preserve Unix LF on checksum manifest and markdown/docs
SHA256SUMS.txt text eol=lf
*.md text eol=lf
LICENSE text eol=lf

# Binary assets (no line-ending conversion, no diff)
*.bin binary
*.exe binary
*.dll binary
*.DLL binary
